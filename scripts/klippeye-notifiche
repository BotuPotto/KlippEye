#!/usr/bin/env bash
# Old command of the notifier ("klippeye-notifiche prova | controlla | stato | log | riavvia | disinstalla"), now a wrapper of "klippeye".
# English names work too: test | check | status | log | restart | uninstall.
V="$(dirname "$(readlink -f "$0")")/klippeye"
SUDO="${KLIPPEYE_SUDO-sudo}"
NSVC=klippeye-notifier
case "$(basename "$(cd "$(dirname "$V")/.." && pwd)")" in vzbot|VzBot) NSVC=vzbot-notifier ;; esac   # before the move to the new name
case "${1:-help}" in
  prova|test)          exec "$V" notify test ;;
  controlla|check)     exec "$V" notify check ;;
  stato|status)        $SUDO "${KLIPPEYE_SYSTEMCTL:-systemctl}" status "$NSVC" --no-pager -l 2>&1 | head -n 25 ;;
  log)                 exec "$V" log notifier ;;
  riavvia|restart)     exec "$V" restart notifier ;;
  disinstalla|uninstall)
    $SUDO "${KLIPPEYE_SYSTEMCTL:-systemctl}" disable --now "$NSVC" 2>/dev/null
    echo "Notification service stopped and disabled. To turn it on again:  sudo systemctl enable --now $NSVC" ;;
  *) echo "klippeye-notifiche test | check | status | log | restart | uninstall      (all commands: klippeye help)" ;;
esac
