#!/usr/bin/env bash
# klippeye - comandi per il Raspberry (messi in /usr/local/bin da scripts/install.sh).
# Servono solo se qualcosa non va o se vuoi guardare dentro: l'uso normale (aggiornare, riavviare) si fa dalla dashboard.

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [ -n "${KLIPPEYE_DATA:-}" ]; then DATA="$KLIPPEYE_DATA"
elif [ -d "$HOME/printer_data/vzbot" ] && [ ! -d "$HOME/printer_data/klippeye" ]; then DATA="$HOME/printer_data/vzbot"   # prima del passaggio al nuovo nome
elif [ -d "$HOME/printer_data" ]; then DATA="$HOME/printer_data/klippeye"
else DATA="$HOME/klippeye_data"; fi
# prima del passaggio al nuovo nome (cartella ~/vzbot) i servizi si chiamano ancora vzbot e vzbot-notifier
SVC=klippeye; NSVC=klippeye-notifier
case "$(basename "$REPO")" in vzbot|VzBot) SVC=vzbot; NSVC=vzbot-notifier ;; esac
BRAIN_URL="${KLIPPEYE_BRAIN_URL:-http://127.0.0.1:8085}"
SUDO="${KLIPPEYE_SUDO-sudo}"
SYSTEMCTL="${KLIPPEYE_SYSTEMCTL:-systemctl}"

service_for() {  # brain|notifiche|tutto -> nomi dei servizi
  case "${1:-brain}" in
    backend|brain|dashboard|klippeye|vzbot) echo "$SVC" ;;
    notifiche|notifier|notifica) echo "$NSVC" ;;
    tutto|tutti) echo "$SVC $NSVC" ;;
    *) return 1 ;;
  esac
}

release() { tr -d '[:space:]' < "$REPO/VERSION" 2>/dev/null || echo "sconosciuta"; }

case "${1:-aiuto}" in
  versione)
    echo "KlippEye $(release)"
    git -C "$REPO" log -1 --format='commit %h del %cd' --date=short 2>/dev/null
    ;;
  stato)
    echo "KlippEye $(release)   (cartella del programma: $REPO)"
    echo "Dati e impostazioni:  $DATA"
    for s in $SVC $NSVC moonraker; do
      printf '  %-16s %s\n' "$s" "$($SYSTEMCTL is-active "$s" 2>/dev/null || echo 'non trovato')"
    done
    if [ -e "$DATA/non-riparare" ]; then echo "  Autoriparazione    SPENTA (c'e' il file $DATA/non-riparare)"
    elif [ -f "$DATA/ripristino.json" ]; then echo "  Autoriparazione    attiva; ultimo ripristino: $(cat "$DATA/ripristino.json")"
    else echo "  Autoriparazione    attiva (nessun file rovinato finora)"; fi
    python3 - "$BRAIN_URL" "$DATA" <<'PY'
import json, os, sys, urllib.request
headers = {}
try:  # with the password on, the backend wants the internal token of the services on the Raspberry
    headers["X-KlippEye-Token"] = open(os.path.join(sys.argv[2], "internal.token")).read().strip()
except OSError:
    pass
def get(path):
    return json.load(urllib.request.urlopen(urllib.request.Request(sys.argv[1] + path, headers=headers), timeout=4))
try:
    d = get("/api/version")
    print("  Il backend risponde: release %s, interfaccia %s, acceso da %d minuti" % (d.get("release"), d.get("api"), d.get("uptime", 0) // 60))
except Exception as e:
    print("  Il backend NON risponde su %s (%s)" % (sys.argv[1], e))
else:
    try:
        a = get("/api/app/version")
        print("  App Android: " + ("la %s e' pronta per il telefono" % a["version"] if a.get("available") else "niente da offrire (%s)" % a.get("reason", "?")))
    except Exception:
        pass
PY
    ;;
  log)
    svc="$(service_for "${2:-backend}")" || { echo "Quale? backend oppure notifiche"; exit 2; }
    args=(); for s in $svc; do args+=(-u "$s"); done
    journalctl "${args[@]}" -n 80 --no-pager 2>/dev/null || $SUDO journalctl "${args[@]}" -n 80 --no-pager
    ;;
  riavvia)
    svc="$(service_for "${2:-backend}")" || { echo "Quale? backend, notifiche oppure tutto"; exit 2; }
    $SUDO $SYSTEMCTL restart $svc && echo "Riavviato: $svc"
    ;;
  aggiorna)
    # Quello che fa il tasto "Aggiorna" della dashboard, a mano (serve internet e il repository collegato).
    branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    [ -n "$branch" ] || { echo "$REPO non e' un repository git: niente da aggiornare."; exit 1; }
    if [ -n "$(git -C "$REPO" status --porcelain -uno 2>/dev/null)" ]; then
      echo "Ci sono file del programma modificati a mano in $REPO:"; git -C "$REPO" status --short -uno
      echo "Per buttarli via e aggiornare:  klippeye aggiorna --forza"
      [ "${2:-}" = "--forza" ] || exit 1
    fi
    git -C "$REPO" fetch --quiet origin "$branch" || { echo "Non riesco a contattare il repository (internet?)."; exit 1; }
    git -C "$REPO" reset --hard "origin/$branch" --quiet && echo "Aggiornato alla release $(release)."
    $SUDO $SYSTEMCTL restart $SVC && echo "Backend riavviato."
    ;;
  notifiche)
    py="$(command -v python3)"
    case "${2:-aiuto}" in
      prova)     "$py" "$REPO/notifier/klippeye_notifier.py" --config "$DATA/notifier.json" --test ;;
      controlla) "$py" "$REPO/notifier/klippeye_notifier.py" --config "$DATA/notifier.json" --check ;;
      *) echo "klippeye notifiche prova | controlla" ;;
    esac
    ;;
  ripara)
    # controlla i file del programma e rimette a posto quelli rovinati (dopo un blackout); "klippeye ripara log" = cosa e' stato fatto
    if [ "${2:-}" = "log" ]; then tail -n 40 "$DATA/riparazioni.log" 2>/dev/null || echo "Nessuna riparazione registrata."; exit 0; fi
    bash "$REPO/scripts/ripara.sh" && { [ -f "$DATA/ripristino.json" ] && echo "Ultimo ripristino: $(cat "$DATA/ripristino.json")"; }
    echo "Se i file sono stati rimessi a posto: klippeye riavvia"
    ;;
  password)
    [ "$(id -u)" = 0 ] && { echo "Run it without sudo: the password file must stay owned by the service user."; exit 1; }
    # optional dashboard password: "klippeye password" sets it, "remove" removes it, "status" tells how it is
    case "${2:-set}" in
      set|remove|status|logout-all) KLIPPEYE_DATA="$DATA" exec python3 "$REPO/backend/access.py" "${2:-set}" ;;
      *) echo "Usage: klippeye password [set|remove|status|logout-all]"; exit 2 ;;
    esac
    ;;
  access)
    [ "$(id -u)" = 0 ] && { echo "Run it without sudo: the access file must stay owned by the service user."; exit 1; }
    # extra host names and network checks:  klippeye access host-add printer.example.com | host-remove NAME | network-checks on|off
    KLIPPEYE_DATA="$DATA" exec python3 "$REPO/backend/access.py" "${2:-status}" "${@:3}"
    ;;
  annulla)
    exec bash "$REPO/scripts/install.sh" --annulla
    ;;
  *)
    cat <<'HELP'
klippeye stato             dice se i servizi sono accesi e se il backend risponde
klippeye versione          la release installata
klippeye log [notifiche]   le ultime righe del registro (del backend, o delle notifiche)
klippeye riavvia [backend|notifiche|tutto]
klippeye ripara            controlla i file del programma e rimette a posto quelli rovinati da un blackout  (ripara log: cosa e' stato fatto)
klippeye aggiorna          scarica l'ultima versione e riavvia (come il tasto Aggiorna della dashboard)
klippeye notifiche prova   manda una notifica di prova al telefono   (anche: controlla)
klippeye password [set|remove|status|logout-all]   optional dashboard password ("klippeye password" sets it)
klippeye access host-add NAME   allows one more host name (e.g. printer.example.com)   (also: host-remove NAME, network-checks on|off, status)
klippeye annulla           torna alla disposizione dei file di prima dell'installazione a contenitore (release 1.0)
HELP
    ;;
esac
