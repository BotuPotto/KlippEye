# GESTITO-DA-KLIPPEYE: questo file e' riscritto da scripts/install.sh; le modifiche a mano si perdono al prossimo giro.
# KlippEye - backend: serve la dashboard, fa da ponte verso Moonraker e controlla la stampa con la camera (monitor IA).
# Modello: scripts/install.sh sostituisce @UTENTE@, @CODICE@, @DATI@ e @PYTHON@ e lo mette in /etc/systemd/system/klippeye.service.
# Il nome del servizio DEVE restare "klippeye": e' quello che l'update manager di Moonraker riavvia dopo un aggiornamento.
[Unit]
Description=KlippEye - backend (dashboard e monitor IA)
After=network.target moonraker.service

[Service]
Type=simple
User=@UTENTE@
WorkingDirectory=@CODICE@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=KLIPPEYE_DATA=@DATI@
# Before every start: check the program files and restore those damaged by a power loss ("-" = start anyway if it fails).
ExecStartPre=-/bin/bash @CODICE@/scripts/repair.sh --quiet
ExecStart=@PYTHON@ @CODICE@/backend/klippeye_backend.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
