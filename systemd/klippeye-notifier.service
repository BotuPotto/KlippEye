# MANAGED-BY-KLIPPEYE: this file is rewritten by scripts/install.sh; changes made by hand are lost the next time.
# KlippEye - push notifications to the phone (Firebase). Template: see klippeye.service.
# It restarts by itself when an update replaces its program (klippeye_notifier.py notices and exits).
[Unit]
Description=KlippEye - push notifications to the phone
After=network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DATA@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ @CODE@/notifier/klippeye_notifier.py --config @DATA@/notifier.json
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
