<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Raspberry is reached over plain http on the home network (its own certificate, when HTTPS is on, is checked by
         Certificates.kt instead). Addresses.kt and Printers.kt accept only private networks, so cleartext stays at home. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
