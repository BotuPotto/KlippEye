<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KlippEye.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vz_accent</item>
        <item name="colorPrimaryDark">@color/vz_bg</item>
        <item name="android:statusBarColor">@color/vz_bg</item>
        <item name="android:navigationBarColor">@color/vz_bg</item>
        <!-- Barre sempre scure, con le icone chiare, anche con il tema chiaro del telefono. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <!-- Finestra scura fin dal primo frame: niente lampo bianco prima della splash. -->
        <item name="android:windowBackground">@color/vz_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Da Android 12 la splash di sistema è in values-v31/themes.xml. -->
    <style name="Theme.KlippEye" parent="Theme.KlippEye.Base" />
</resources>
