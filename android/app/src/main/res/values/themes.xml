<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KlippEye.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ke_accent</item>
        <item name="colorPrimaryDark">@color/ke_bg</item>
        <item name="android:statusBarColor">@color/ke_bg</item>
        <item name="android:navigationBarColor">@color/ke_bg</item>
        <!-- Bars always dark with light icons, even with the phone's light theme. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <!-- A dark window from the first frame: no white flash before the splash. -->
        <item name="android:windowBackground">@color/ke_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- From Android 12 the system splash is set in values-v31/themes.xml. -->
    <style name="Theme.KlippEye" parent="Theme.KlippEye.Base" />
</resources>
